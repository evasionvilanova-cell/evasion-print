# Copia estas variables en Vercel → Settings → Environment Variables

# Base de datos (la crea Vercel al conectar Neon: Storage → Neon)
DATABASE_URL=

# Archivos (lo crea Vercel al conectar Blob: Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Una frase larga y aleatoria (mínimo 24 caracteres). No la compartas.
SESSION_SECRET=

# Acceso a Gestión
ADMIN_EMAIL=tienda@evasionprint.com
ADMIN_PASSWORD=

# Redsys (TPV virtual de tu banco). Mientras no lleguen los datos del banco,
# puedes usar los de pruebas públicos de Redsys: 999008881 / 1 / sq7HjrUOBfKmC576ILgskD5srU870gJ7
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
# test = entorno de pruebas · real = cobros de verdad
REDSYS_ENV=test
# off si el banco aún no ha activado Bizum
REDSYS_BIZUM=on

# Dirección pública de la web (para las URL de vuelta de Redsys)
SITE_URL=https://evasionprint.com

# Emails (opcional): https://resend.com con el dominio evasionprint.com verificado
RESEND_API_KEY=
MAIL_FROM=Evasion Print <info@evasionprint.com>
SHOP_EMAIL=info@evasionprint.com

# Solo para una vista previa sin Redsys: on = el pago se simula
SIMULATED_PAY=
